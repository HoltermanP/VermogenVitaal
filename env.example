# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tax_wealth_hub"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/signin"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# NextAuth (deprecated - wordt vervangen door Clerk)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs - Abonnementen
STRIPE_BASIC_PRICE_ID="price_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ELITE_PRICE_ID="price_..."

# Stripe Price IDs - Add-ons (one-time payments)
STRIPE_FISCALE_OPTIMALISATIE_CHECK_PRICE_ID="price_..."
STRIPE_PREMIUM_DOCUMENT_ANALYSE_PRICE_ID="price_..."
STRIPE_DUE_DILIGENCE_VASTGOED_PRICE_ID="price_..."

# Resend
RESEND_API_KEY="re_..."

# PostHog
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# OpenAI (optioneel)
OPENAI_API_KEY="sk-..."

# App configuratie
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryptie (gebruikt NEXTAUTH_SECRET als fallback)
ENCRYPTION_SECRET="your-encryption-secret-here"

# Exact Online API
EXACT_ONLINE_CLIENT_ID="your-exact-online-client-id"
EXACT_ONLINE_CLIENT_SECRET="your-exact-online-client-secret"
EXACT_ONLINE_REDIRECT_URI="http://localhost:3000/api/accounting/callback"

# Moneybird API
MONEYBIRD_CLIENT_ID="your-moneybird-client-id"
MONEYBIRD_CLIENT_SECRET="your-moneybird-client-secret"
MONEYBIRD_REDIRECT_URI="http://localhost:3000/api/accounting/callback"

# e-Boekhouden API (API Key authenticatie)
E_BOEKHOUDEN_API_KEY="your-e-boekhouden-api-key"
E_BOEKHOUDEN_API_SECRET="your-e-boekhouden-api-secret"

# Alpha Vantage API (voor beurskoersen)
# Gratis tier: 5 calls/min, 500 calls/dag
# Registreer op https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY="demo"

# Financial Modeling Prep API (voor uitgebreide financiële data)
# Gratis tier: 250 calls/dag
# Registreer op https://site.financialmodelingprep.com/developer/docs/
# Optioneel maar aanbevolen voor betere deep research kwaliteit
FMP_API_KEY="your-fmp-api-key"
FINANCIAL_MODELING_PREP_API_KEY="your-fmp-api-key"

# News API (voor realtime nieuws)
# Gratis tier: 100 requests/dag
# Registreer op https://newsapi.org/register
# Optioneel - enhanced news service gebruikt gratis RSS feeds als fallback
NEWS_API_KEY="your-news-api-key"

# EasyBook URL (voor boekhouding en belastingaangiftes)
NEXT_PUBLIC_EASYBOOK_URL="https://easybook.nl"

# PoliAPI (voor congressional stock trades) - AANBEVOLEN VOOR PRODUCTIE
# Registreer op https://www.poliapi.com voor API key (vanaf $29/maand)
# Zonder API key wordt geprobeerd gratis alternatieven te gebruiken (GitHub repositories)
# Zie CONGRESSIONAL_TRADES_API.md voor volledige instructies
POLIAPI_API_KEY="your-poliapi-api-key-here"

# Quiver Quantitative (alternatief voor congressional stock trades)
# Registreer op https://www.quiverquant.com voor gratis tier
# Optioneel: Kan gebruikt worden als alternatief voor PoliAPI
QUIVER_API_KEY="your-quiver-api-key-here"

# RapidAPI (voor congressional stock trades)
# Registreer op https://rapidapi.com en abonneer op Politician Trade Tracker API
# Voeg je RapidAPI key hier toe
RAPIDAPI_KEY="your-rapidapi-key-here"
# Host voor Politician Trade Tracker (wordt automatisch gedetecteerd als leeg)
RAPIDAPI_HOST="politician-trade-tracker1.p.rapidapi.com"
